# Copy to .env and adjust. Every variable is optional except the two keys in production.
# Generate keys with:  docker compose run --rm app talentengine keygen
TE_VAULT_KEY=
TE_LEDGER_SEAL_KEY=

# Prefer named accounts: `talentengine adduser NAME --role recruiter|dpo|admin` (one personal key each).
# TE_API_KEY is a legacy single shared admin key; leave it empty once accounts exist.
TE_API_KEY=
# Automatic erasure of applications past their retention period (hours between sweeps, 0 disables).
TE_RETENTION_SWEEP_HOURS=24

# Module 1: statistical name detection on top of the rules (masks managers, clients, referees...).
# The Docker image ships the models and enables it; from source: pip install ".[ner]" + spacy download.
TE_NER=spacy

# Module 1: visual redaction. "ollama" needs the `vision` compose profile and `ollama pull qwen2.5vl:7b`.
TE_VISION_DETECTOR=none
TE_OLLAMA_URL=http://ollama:11434
TE_VISION_MODEL=qwen2.5vl:7b

# Module 2, level 2: commercial escalation (off by default, and opt-in per job in the studio).
TE_LLM_PROVIDER=none
TE_LLM_MODEL=claude-opus-5-5
TE_LLM_API_KEY=
TE_LLM_BASE_URL=
TE_LLM_PRICE_INPUT_PER_MTOK=4.0
TE_LLM_PRICE_OUTPUT_PER_MTOK=20.0

# AI-pilot test (docs/PILOT_TEST.md). "scripted" = reference assistant, identical for every candidate.
TE_PILOT_ASSISTANT=scripted
# With TE_PILOT_ASSISTANT=llm, the assistant candidates pilot (e.g. Qwen-Coder or Llama-3 on Ollama / vLLM)
TE_PILOT_LLM_PROVIDER=ollama
TE_PILOT_LLM_MODEL=qwen2.5-coder:7b
TE_PILOT_LLM_BASE_URL=
TE_PILOT_LLM_API_KEY=
# Judge = the escalation provider above, when configured
TE_PILOT_JUDGE=true
TE_PILOT_STARTS_PER_HOUR=6
TE_OWNERSHIP_SOURCE_FILES=3

TE_GITHUB_TOKEN=
TE_ENABLE_DEMO=true
